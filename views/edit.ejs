<%- include('partials/header') %>

<div class="form-page">
  <h1>Edit Story</h1>
  <% if (error) { %>
    <p class="error"><%= error %></p>
  <% } %>
  <form action="/post/<%= post.id %>/edit" method="POST" enctype="multipart/form-data" class="stacked-form">
    <label for="title">Title</label>
    <input type="text" id="title" name="title" required maxlength="120" value="<%= post.title %>" />

    <label for="story">Your Story</label>
    <textarea id="story" name="story" rows="10" required><%= post.story %></textarea>

    <% if (post.photo_filename) { %>
      <p>Current photo:</p>
      <img src="<%= post.photo_filename %>" alt="Current selfie" class="current-photo" />
      <label class="checkbox-label">
        <input type="checkbox" name="removePhoto" />
        Remove this photo
      </label>
    <% } %>

    <label for="photo"><%= post.photo_filename ? 'Replace photo (optional)' : 'Add a selfie (optional)' %></label>
    <input type="file" id="photo" name="photo" accept="image/png, image/jpeg, image/gif, image/webp, video/mp4, video/quicktime, video/avi, video/mov" />

    <button type="submit">Save Changes</button>
  </form>
</div>

<%- include('partials/footer') %>
