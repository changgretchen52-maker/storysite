<%- include('partials/header') %>

<h1>☀️ Latest Stories</h1>
<% if (tagline) { %>
  <p style="color: #000000; font-size: 1.2rem; margin-top: -4px; margin-bottom: 20px;"><%= tagline %> 📮💌👩🏻‍🎓</p>
<% } %>

<!-- 分类导航 -->
<div class="category-nav">
  <a href="/" class="cat-link active">🏠 全部</a>
  <a href="/?cat=story" class="cat-link">📖 故事</a>
  <a href="/?cat=photo" class="cat-link">🖼️ 图文</a>
  <a href="/?cat=video" class="cat-link">🎬 视频</a>
</div>

<% if (posts.length === 0) { %>
  <p class="empty-state">还没有文章，<a href="/new">写第一篇吧</a>！</p>
<% } %>

<div class="posts-grid">
  <% posts.forEach(post => { %>
    <% const hasImage = post.photo_filename !== null; %>
    <% const isVideo = post.photo_filename && (post.photo_filename.endsWith('.mp4') || post.photo_filename.endsWith('.mov') || post.photo_filename.endsWith('.avi')); %>
    
    <article class="post-card <%= hasImage ? 'has-image' : 'text-only' %>">
      <% if (hasImage) { %>
        <a href="/post/<%= post.id %>" class="post-thumb-link">
          <% if (isVideo) { %>
            <video src="/uploads/<%= post.photo_filename %>" class="post-thumb" muted></video>
          <% } else { %>
            <img src="/uploads/<%= post.photo_filename %>" alt="<%= post.title %>" class="post-thumb" loading="lazy" />
          <% } %>
          <% if (post.read_time > 1) { %>
            <span class="read-time-badge">📖 <%= post.read_time %> min</span>
          <% } %>
        </a>
      <% } %>
      
      <div class="post-content">
        <div class="post-meta-top">
          <a href="/user/<%= post.username %>" class="post-author">
            <% if (post.avatar_filename) { %>
              <img src="/uploads/<%= post.avatar_filename %>" alt="" class="post-author-avatar" />
            <% } else { %>
              <span class="post-author-avatar placeholder"><%= post.username.charAt(0).toUpperCase() %></span>
            <% } %>
            <span><%= post.username %></span>
          </a>
          <span class="post-date"><%= new Date(post.created_at).toLocaleDateString() %></span>
        </div>
        
        <a href="/post/<%= post.id %>" class="post-title-link">
          <h2 class="post-title"><%= post.title %></h2>
        </a>
        
        <p class="post-excerpt"><%= post.excerpt || post.story.substring(0, 160) + '...' %></p>
        
        <div class="post-footer">
          <div class="post-actions">
            <form action="/post/<%= post.id %>/like" method="POST" style="display:inline;">
              <button type="submit" class="stat-btn <%= post.user_liked ? 'liked' : '' %>">
                <%= post.user_liked ? '❤️' : '🤍' %> <span><%= post.like_count || 0 %></span>
              </button>
            </form>
            <a href="/post/<%= post.id %>#comments" class="stat-btn">
              💬 <span><%= post.comment_count || 0 %></span>
            </a>
          </div>
          <a href="/post/<%= post.id %>" class="read-more">阅读全文 →</a>
        </div>
      </div>
    </article>
  <% }) %>
</div>

<style>
.category-nav {
  display: flex;
  gap: 8px;
  padding-bottom: 16px;
  border-bottom: 1px solid var(--border);
  margin-bottom: 28px;
  flex-wrap: wrap;
}
.cat-link {
  padding: 6px 16px;
  border-radius: 20px;
  text-decoration: none;
  font-size: 0.85rem;
  color: var(--muted);
  transition: all 0.3s;
}
.cat-link:hover { background: var(--bg); color: var(--ink); }
.cat-link.active { background: var(--accent); color: white; }
.posts-grid { display: flex; flex-direction: column; gap: 32px; }
.post-card {
  background: var(--card-bg);
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 1px 4px rgba(0,0,0,0.04);
  transition: box-shadow 0.3s, transform 0.3s;
  display: flex;
  flex-direction: column;
}
.post-card:hover {
  box-shadow: 0 8px 30px rgba(0,0,0,0.08);
  transform: translateY(-2px);
}
.post-card.has-image .post-thumb-link {
  display: block;
  position: relative;
  overflow: hidden;
  height: 240px;
}
.post-thumb {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s;
}
.post-card:hover .post-thumb { transform: scale(1.02); }
.read-time-badge {
  position: absolute;
  bottom: 12px;
  right: 12px;
  background: rgba(0,0,0,0.7);
  color: white;
  font-size: 0.7rem;
  padding: 4px 10px;
  border-radius: 12px;
  backdrop-filter: blur(4px);
}
.post-card.text-only .post-content { padding: 20px 24px; }
.post-content { padding: 18px 20px 20px; flex: 1; display: flex; flex-direction: column; }
.post-meta-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
  font-size: 0.8rem;
}
.post-author {
  display: flex;
  align-items: center;
  gap: 8px;
  text-decoration: none;
  color: var(--ink);
  font-weight: 500;
}
.post-author-avatar {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  object-fit: cover;
}
.post-author-avatar.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--accent);
  color: white;
  font-weight: 700;
  font-size: 0.7rem;
}
.post-date { color: var(--muted); font-size: 0.75rem; }
.post-title-link { text-decoration: none; color: inherit; }
.post-title {
  font-size: 1.25rem;
  font-weight: 600;
  margin: 0 0 8px;
  line-height: 1.4;
  transition: color 0.2s;
}
.post-title-link:hover .post-title { color: var(--accent); }
.post-excerpt {
  color: var(--muted);
  font-size: 0.92rem;
  line-height: 1.6;
  margin: 0 0 14px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.post-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: auto;
  padding-top: 14px;
  border-top: 1px solid var(--border);
}
.post-actions { display: flex; gap: 12px; }
.stat-btn {
  background: none;
  border: none;
  font-size: 0.8rem;
  cursor: pointer;
  padding: 4px 8px;
  border-radius: 6px;
  text-decoration: none;
  color: var(--muted);
  display: flex;
  align-items: center;
  gap: 4px;
  transition: background 0.2s;
}
.stat-btn:hover { background: rgba(0,0,0,0.04); }
.stat-btn.liked { color: #e74c3c; }
.read-more {
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--accent);
  text-decoration: none;
  transition: color 0.2s;
}
.read-more:hover { color: var(--accent-dark); }
@media (min-width: 768px) {
  .post-card.has-image { flex-direction: row; }
  .post-card.has-image .post-thumb-link { width: 40%; height: auto; min-height: 200px; }
  .post-card.has-image .post-content { width: 60%; padding: 24px 28px; }
}
@media (max-width: 600px) {
  .post-card.has-image .post-thumb-link { height: 180px; }
  .post-title { font-size: 1.05rem; }
}
</style>

<%- include('partials/footer') %>
