<%- include('partials/header') %>

<div class="chat-container">
  <div class="chat-header">
    <a href="/messages" class="back-btn">← 返回</a>
    <span class="chat-username">@<%= otherUser.username %></span>
  </div>
  
  <div class="chat-messages" id="chatMessages">
    <% messages.forEach(m => { %>
      <div class="message <%= m.sender_id === currentUser.id ? 'sent' : 'received' %>">
        <div class="message-bubble">
          <%= m.content %>
        </div>
        <div class="message-time"><%= new Date(m.created_at).toLocaleString() %></div>
      </div>
    <% }) %>
  </div>
  
  <form action="/messages/<%= otherUser.id %>" method="POST" class="chat-form" id="chatForm">
    <input type="text" name="content" placeholder="输入消息..." required autocomplete="off" />
    <button type="submit">发送</button>
  </form>
</div>

<style>
.chat-container { max-width: 700px; margin: 0 auto; display: flex; flex-direction: column; height: calc(100vh - 200px); }
.chat-header { display: flex; align-items: center; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--border); }
.back-btn { text-decoration: none; color: var(--accent); font-weight: 600; }
.chat-username { font-weight: 700; font-size: 1.1rem; }
.chat-messages { flex: 1; overflow-y: auto; padding: 16px 0; display: flex; flex-direction: column; gap: 8px; }
.message { display: flex; flex-direction: column; max-width: 70%; }
.message.sent { align-self: flex-end; }
.message.received { align-self: flex-start; }
.message-bubble { padding: 10px 14px; border-radius: 12px; word-wrap: break-word; }
.message.sent .message-bubble { background: var(--accent); color: white; border-bottom-right-radius: 4px; }
.message.received .message-bubble { background: var(--bg); border: 1px solid var(--border); border-bottom-left-radius: 4px; }
.message-time { font-size: 0.7rem; color: var(--muted); margin-top: 2px; padding: 0 4px; }
.message.sent .message-time { text-align: right; }
.chat-form { display: flex; gap: 8px; padding: 12px 0; border-top: 1px solid var(--border); }
.chat-form input { flex: 1; padding: 10px 14px; border: 1px solid var(--border); border-radius: 20px; font-size: 1rem; }
.chat-form button { padding: 10px 24px; background: var(--accent); color: white; border: none; border-radius: 20px; cursor: pointer; font-weight: 600; }
.chat-form button:hover { background: var(--accent-dark); }
</style>

<script>
const messagesContainer = document.getElementById('chatMessages');
if (messagesContainer) {
  messagesContainer.scrollTop = messagesContainer.scrollHeight;
}
setInterval(() => { location.reload(); }, 5000);
</script>

<%- include('partials/footer') %>
